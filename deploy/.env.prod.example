# Copy to .env.prod in the repository root on the server. Never commit .env.prod.

# Domain whose DNS A/AAAA record points at this server. Caddy gets the HTTPS
# certificate for it automatically. Use "localhost" only for a local test.
DOMAIN=lifetrack.example.com

POSTGRES_DB=lifetrack
POSTGRES_USER=lifetrack
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SECRET=

# SMTP for verification and password reset codes; the backend won't start without it.
# Any provider works (Gmail with an app password, Brevo, Mailgun, Amazon SES...).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Sender shown to users; most providers require a verified address or domain.
MAIL_FROM=LifeTrack <no-reply@lifetrack.example.com>

JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=30
TZ=Europe/Istanbul

BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
