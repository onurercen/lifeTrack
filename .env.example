# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_DB=lifetrack
POSTGRES_USER=lifetrack
POSTGRES_PASSWORD=admin123

# Backend
DB_URL=jdbc:postgresql://localhost:5432/lifetrack
DB_USERNAME=lifetrack
DB_PASSWORD=admin123
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (15 min) and refresh token lifetime.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=30
# Comma separated origin patterns allowed to call the API from a browser.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# Time zone of the backend container (run dates are stored as local time).
TZ=Europe/Istanbul
